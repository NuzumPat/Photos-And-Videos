//- This page displays the photos in a Gallery Style and created menu item on the right side,
//- based on the folder names. 
//- The only way to get to this page is when selecting "photos" from the top level 
//- navigation bar (Home, About, photos, videos, and Contact)
//- You will stay on this page as long as you keep selecting menu item from the right-side menus.
//- 
extends layout_videos
block content
  div#wrapper2
    div#altnav
      ul.navigation-menu
        include includes/altnav.pug
        include includes/navjs.pug
    div#contents
      #jp_container_1.jp-video.jp-video-270p(role='application', aria-label='media player')
        .jp-type-playlist
          #jquery_jplayer_1.jp-jplayer
          | &#x9;&#x9;
          .jp-gui
            .jp-video-play
              button.jp-video-play-icon(role='button', tabindex='0') play
            | &#x9;&#x9;&#x9;
            .jp-interface
              .jp-progress
                .jp-seek-bar
                  .jp-play-bar
              | &#x9;&#x9;&#x9;&#x9;
              .jp-current-time(role='timer', aria-label='time') &nbsp;
              | &#x9;&#x9;&#x9;&#x9;
              .jp-duration(role='timer', aria-label='duration') &nbsp;
              | &#x9;&#x9;&#x9;&#x9;
              .jp-details
                .jp-title(aria-label='title') &nbsp;
              | &#x9;&#x9;&#x9;&#x9;
              .jp-controls-holder
                .jp-volume-controls
                  button.jp-mute(role='button', tabindex='0') mute
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-volume-max(role='button', tabindex='0') max volume
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  .jp-volume-bar
                    .jp-volume-bar-value
                | &#x9;&#x9;&#x9;&#x9;&#x9;
                .jp-controls
                  button.jp-previous(role='button', tabindex='0') previous
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-play(role='button', tabindex='0') play
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-stop(role='button', tabindex='0') stop
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-next(role='button', tabindex='0') next
                | &#x9;&#x9;&#x9;&#x9;&#x9;
                .jp-toggles
                  button.jp-repeat(role='button', tabindex='0') repeat
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-shuffle(role='button', tabindex='0') shuffle
                  | &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;
                  button.jp-full-screen(role='button', tabindex='0') full screen
          | &#x9;&#x9;
          .jp-playlist
            ul
              // The method Playlist.displayPlaylist() uses this unordered list
              li
          | &#x9;&#x9;
          .jp-no-solution
            span Update Required
            | &#x9;&#x9;&#x9;To play the media you will need to either update your browser to a recent version or update your 
            a(href='http://get.adobe.com/flashplayer/', target='_blank') Flash plugin
            | .
    div#rightside
      div#videos-rightsidebar
        p Menu Items:
        ul.navigation-menu
          include includes/rightsidenav.pug
    include includes/footer.pug
